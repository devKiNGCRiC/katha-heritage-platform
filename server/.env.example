# 🔐 KATHA Heritage Platform - Environment Variables
# 📝 Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=5000

# 🗄️ Database Configuration (MongoDB Atlas FREE)
# Get your connection string from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/katha-heritage?retryWrites=true&w=majority

# 🔑 JWT Secret Keys (Generate random strings)
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-here
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-here

# 🌐 OAuth Configuration (FREE from providers)
# Google OAuth: https://console.developers.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth: https://developers.facebook.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# GitHub OAuth: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# 📸 Cloudinary Configuration (FREE tier)
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# 📧 Email Configuration (FREE with Gmail)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-specific-password

# 🤖 AI Services (FREE tiers available)
# Hugging Face: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-huggingface-token

# OpenAI (Optional - has free credits for new users)
OPENAI_API_KEY=your-openai-api-key

# 📊 Analytics (FREE)
# Google Analytics: https://analytics.google.com
GA_TRACKING_ID=your-ga-tracking-id

# Sentry Error Tracking (FREE tier)
SENTRY_DSN=your-sentry-dsn

# 🌐 Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# 🔒 Session Secret
SESSION_SECRET=your-session-secret-key