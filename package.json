{
  "name": "katha-heritage-platform",
  "version": "1.0.0",
  "description": "A comprehensive platform for Indian heritage, history, and cultural learning",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "test": "jest",
    "install-deps": "npm install && cd client && npm install && cd ../server && npm install"
  },
  "keywords": [
    "indian-heritage",
    "cultural-platform",
    "education",
    "history",
    "mythology",
    "mern-stack",
    "react-native"
  ],
  "author": "Raj Roy (KiNG) <kingraj28roy@gmail.com> (https://github.com/devKiNGCRiC)",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devKiNGCRiC/katha-heritage-platform"
  }
}
